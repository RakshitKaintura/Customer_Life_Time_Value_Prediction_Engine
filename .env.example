# ============================================================
# LTV Prediction Engine — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Postgres connection (for SQLAlchemy / asyncpg)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ── Weights & Biases ─────────────────────────────────────────
WANDB_API_KEY=your-wandb-api-key
WANDB_PROJECT=ltv-prediction
WANDB_ENTITY=your-wandb-username

# ── Data Paths ───────────────────────────────────────────────
DATA_DIR=./data/raw
PROCESSED_DIR=./data/processed
MODELS_DIR=./models
UCI_CSV_PATH=./data/raw/online_retail.csv

# ── Pipeline Config ──────────────────────────────────────────
OBSERVATION_WINDOW_MONTHS=6
HOLDOUT_WINDOW_MONTHS=6
MAX_SEQUENCE_LENGTH=50
AMOUNT_BUCKET_COUNT=5

# ── API ──────────────────────────────────────────────────────
API_SECRET_KEY=change-me-to-a-random-secret
API_RATE_LIMIT_PER_MINUTE=100

# ── Marketing Integrations ───────────────────────────────────
# ── Airtable CRM ────────────────────────────────────────────
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_SYNC_DAYS=0        # 0 = all records, >0 = last N days
AIRTABLE_EMAIL_FIELD=email

# ── Brevo (Sendinblue) ─────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_TEMPLATE_CHAMPIONS=
BREVO_TEMPLATE_HIGH=
BREVO_TEMPLATE_MEDIUM=
BREVO_TEMPLATE_LOW=
BREVO_DAILY_LIMIT=300

# ── Environment ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Set true to run marketing sync once and exit.
MARKETING_SYNC_ONCE=false
